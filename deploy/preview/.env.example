# Set `http://SERVER_IP` for a quick password-protected preview.
# Switch to `preview.example.com` when you are ready to use HTTPS.
PREVIEW_SITE_ADDRESS=http://SERVER_IP
PREVIEW_HTTP_PORT=80
PREVIEW_HTTPS_PORT=443

# Generate this hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
PREVIEW_BASIC_AUTH_USER=client
PREVIEW_BASIC_AUTH_PASSWORD_HASH=

# Browser-facing URL. Keep this aligned with PREVIEW_SITE_ADDRESS.
NEXT_PUBLIC_STRAPI_URL=http://SERVER_IP

DATABASE_NAME=paritet
DATABASE_USERNAME=paritet
DATABASE_PASSWORD=change-me-now

# Comma-separated values for Strapi.
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-32-chars-minimum
